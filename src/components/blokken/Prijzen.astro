---
import type { Blok } from "../../lib/content";

interface Props {
  blok: Extract<Blok, { type: "prijzen" }>;
  toon: "licht" | "donker";
}
const { blok, toon } = Astro.props;
---

<section class:list={["sectie", "prijzen", `toon-${toon}`]} data-in-beeld id="tarieven">
  <div class="container">
    {
      (blok.kop || blok.subkop) && (
        <header class="sectie__kop">
          {blok.label && <span class="label">{blok.label}</span>}
          {blok.kop && <h2>{blok.kop}</h2>}
          {blok.subkop && <p>{blok.subkop}</p>}
        </header>
      )
    }
    <ul class="prijzen__lijst">
      {
        blok.pakketten.map((p) => (
          <li class:list={["prijzen__kaart", { "prijzen__kaart--populair": p.populair }]}>
            {p.populair && <span class="prijzen__label">Populair</span>}
            <h3>{p.naam}</h3>
            {p.omschrijving && <p class="prijzen__omschrijving">{p.omschrijving}</p>}
            <p class="prijzen__prijs">
              <span class="sr-only">Prijs: </span>
              <span class="prijzen__valuta" aria-hidden="true">€</span>
              <span class="sr-only">€</span>
              {p.prijs}
            </p>
            {p.toelichting && <p class="prijzen__toelichting">{p.toelichting}</p>}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .prijzen .container {
    max-inline-size: 64rem;
  }
  .prijzen__lijst {
    display: grid;
    gap: var(--r-6);
    margin: 0;
    padding: 0;
    list-style: none;
    align-items: stretch;
  }
  @container sectie (width > 46rem) {
    .prijzen__lijst {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .prijzen__kaart {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--r-8) var(--r-6) var(--r-6);
    border-radius: var(--hoek-lg);
    background: var(--kaart);
    color: var(--kaart-tekst);
    border: 1px solid hsl(186 30% 86%);
    text-align: center;
    transition: translate 0.25s ease, box-shadow 0.25s ease;
  }
  .prijzen__kaart:hover {
    translate: 0 -4px;
    box-shadow: var(--schaduw);
  }
  /* De populaire keuze in omgekeerde kleuren */
  .prijzen__kaart--populair {
    background: var(--petrol-800);
    color: var(--wit);
    border-color: var(--petrol-800);
    --kaart-tekst-zacht: hsl(186 40% 90%);
  }
  .prijzen__kaart h3 {
    color: inherit;
    margin-block-end: var(--r-1);
  }
  .prijzen__label {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 50%;
    translate: -50% -50%;
    padding: var(--r-1) var(--r-4);
    border-radius: var(--hoek-pil);
    background: var(--wit);
    color: var(--petrol-800);
    border: 1px solid var(--petrol-800);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .prijzen__omschrijving {
    margin: 0;
    font-size: var(--tekst-sm);
    color: var(--kaart-tekst-zacht);
  }
  .prijzen__prijs {
    margin: var(--r-6) 0 0;
    padding-block-end: var(--r-6);
    border-block-end: 1px solid color-mix(in oklab, currentColor 18%, transparent);
    font-family: var(--font-kop);
    font-size: 3rem;
    line-height: 1;
    white-space: nowrap;
  }
  .prijzen__valuta {
    font-size: 0.5em;
    vertical-align: 0.75em;
    margin-inline-end: 0.12em;
  }
  .prijzen__toelichting {
    margin: var(--r-4) 0 0;
    font-size: var(--tekst-sm);
    color: var(--kaart-tekst-zacht);
  }
  @media (prefers-reduced-motion: reduce) {
    .prijzen__kaart:hover {
      translate: none;
    }
  }
</style>
