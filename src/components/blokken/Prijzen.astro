---
import type { Blok } from "../../lib/content";

interface Props {
  blok: Extract<Blok, { type: "prijzen" }>;
}
const { blok } = Astro.props;
---

<section class="sectie prijzen" data-in-beeld>
  <div class="container">
    {
      (blok.kop || blok.subkop) && (
        <header class="sectie__kop">
          {blok.kop && <h2>{blok.kop}</h2>}
          {blok.subkop && <p>{blok.subkop}</p>}
        </header>
      )
    }
    <ul class="prijzen__lijst">
      {
        blok.pakketten.map((p) => (
          <li class:list={["prijzen__kaart", { "prijzen__kaart--populair": p.populair }]}>
            {p.populair && <span class="prijzen__label">Populair</span>}
            <h3>{p.naam}</h3>
            {p.omschrijving && <p class="prijzen__omschrijving">{p.omschrijving}</p>}
            <p class="prijzen__prijs">
              <span class="sr-only">Prijs: </span>
              <span class="prijzen__valuta" aria-hidden="true">€</span>
              <span class="sr-only">€</span>
              {p.prijs}
            </p>
            {p.toelichting && <p class="prijzen__toelichting">{p.toelichting}</p>}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .prijzen .container {
    max-width: 64rem;
  }
  .prijzen__lijst {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--r-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .prijzen__kaart {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--r-8) var(--r-6) var(--r-6);
    border-radius: var(--hoek-lg);
    background: var(--kaart);
    color: var(--kaart-tekst);
    box-shadow: var(--schaduw);
    text-align: center;
  }
  .prijzen__kaart--populair {
    box-shadow: 0 0 0 2px var(--petrol-700), var(--schaduw);
  }
  .prijzen__kaart h3 {
    color: var(--petrol-800);
    margin-bottom: var(--r-1);
  }
  .prijzen__label {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    padding: var(--r-1) var(--r-4);
    border-radius: var(--hoek-pil);
    background: var(--petrol-700);
    color: var(--wit);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .prijzen__omschrijving {
    margin: 0;
    font-size: var(--tekst-sm);
    color: var(--kaart-tekst-zacht);
  }
  .prijzen__prijs {
    margin: var(--r-6) 0 0;
    padding-bottom: var(--r-6);
    border-bottom: 1px solid var(--petrol-100);
    font-family: var(--font-kop);
    font-size: 2.75rem;
    line-height: 1;
    color: var(--petrol-800);
    white-space: nowrap;
  }
  .prijzen__valuta {
    font-size: 0.55em;
    vertical-align: 0.6em;
    margin-right: 0.1em;
  }
  .prijzen__toelichting {
    margin: var(--r-4) 0 0;
    font-size: var(--tekst-sm);
    color: var(--kaart-tekst-zacht);
  }
</style>
