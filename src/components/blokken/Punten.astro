---
import Icon from "../Icon.astro";
import { md, type Blok } from "../../lib/content";

interface Props {
  blok: Extract<Blok, { type: "punten" }>;
}
const { blok } = Astro.props;
---

<section class="sectie punten" data-in-beeld>
  <div class="container">
    {
      (blok.kop || blok.intro) && (
        <header class="sectie__kop">
          {blok.kop && <h2>{blok.kop}</h2>}
          {blok.intro && <div class="tekst" set:html={md(blok.intro)} />}
        </header>
      )
    }
    {
      blok.punten.length > 0 && (
        <ul class="punten__lijst">
          {blok.punten.map((p) => (
            <li class="punten__item paneel">
              <Icon naam="vinkje" class="punten__vinkje" />
              <span set:html={md(p, true)} />
            </li>
          ))}
        </ul>
      )
    }
    {blok.afsluiting && <div class="punten__afsluiting tekst" set:html={md(blok.afsluiting)} />}
  </div>
</section>

<style>
  .punten .container {
    max-width: 60rem;
  }
  .punten__afsluiting {
    max-width: var(--smal);
    margin: var(--r-8) auto 0;
    text-align: center;
    color: var(--tekst-zacht);
  }
  .punten__lijst {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: var(--r-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .punten__item {
    display: flex;
    align-items: center;
    gap: var(--r-4);
    padding: var(--r-4) var(--r-6) var(--r-4) var(--r-4);
    border-radius: 1.75rem;
    line-height: 1.45;
    --vinkje: var(--petrol-800);
  }
  .punten__item :global(.punten__vinkje) {
    width: 1.375rem;
    height: 1.375rem;
    color: var(--petrol-100);
  }
</style>
