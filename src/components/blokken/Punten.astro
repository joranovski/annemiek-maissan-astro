---
import Icon from "../Icon.astro";
import { md, type Blok } from "../../lib/content";

interface Props {
  blok: Extract<Blok, { type: "punten" }>;
  toon: "licht" | "donker";
}
const { blok, toon } = Astro.props;
---

<section class:list={["sectie", "punten", `toon-${toon}`]} data-in-beeld>
  <div class="container">
    {
      (blok.kop || blok.intro || blok.label) && (
        <header class="sectie__kop">
          {blok.label && <span class="label">{blok.label}</span>}
          {blok.kop && <h2>{blok.kop}</h2>}
          {blok.intro && <div class="tekst" set:html={md(blok.intro)} />}
        </header>
      )
    }
    {
      blok.punten.length > 0 && (
        <ul class="punten__lijst">
          {blok.punten.map((p) => (
            <li class="punten__item">
              <Icon naam="vinkje" class="punten__vinkje" />
              <span set:html={md(p, true)} />
            </li>
          ))}
        </ul>
      )
    }
    {blok.afsluiting && <div class="punten__afsluiting tekst" set:html={md(blok.afsluiting)} />}
  </div>
</section>

<style>
  .punten .container {
    max-inline-size: 62rem;
  }

  .punten__lijst {
    display: grid;
    gap: var(--r-3) var(--r-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Twee kolommen zodra de sectie breed genoeg is (container query) */
  @container sectie (width > 44rem) {
    .punten__lijst {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .punten__item {
    display: flex;
    align-items: flex-start;
    gap: var(--r-4);
    padding: var(--r-5, 1.25rem) var(--r-6);
    border-radius: var(--hoek-lg);
    background: var(--paneel);
    border: 1px solid var(--paneel-rand);
    line-height: 1.5;
  }

  /* Licht: een rustige lijst met lijntjes in plaats van kaartjes */
  .toon-licht .punten__item {
    background: none;
    border: 0;
    border-block-end: 1px solid var(--paneel-rand);
    border-radius: 0;
    padding-inline: 0;
  }

  .punten__item :global(.punten__vinkje) {
    inline-size: 1.5rem;
    block-size: 1.5rem;
    margin-block-start: 0.05rem;
    color: var(--vinkje-rond, var(--petrol-100));
    --vinkje: var(--vinkje-teken, var(--petrol-800));
  }

  .punten__afsluiting {
    max-inline-size: 40rem;
    margin: var(--r-12) auto 0;
    text-align: center;
    font-family: var(--font-kop);
    font-size: var(--kop-sm);
    line-height: 1.35;
    color: var(--tekst);
  }
</style>
