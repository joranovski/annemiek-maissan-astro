---
// Eigen inline-iconen (vervangt de losse SVG's uit de Kirby-snippets)
interface Props {
  naam: "menu" | "vinkje" | "linkedin" | "youtube" | "facebook" | "instagram" | "mail";
  class?: string;
}
const { naam, class: klasse } = Astro.props;
---

<svg class:list={["icon", klasse]} viewBox={naam === "menu" || naam === "vinkje" || naam === "mail" ? "0 0 24 24" : "0 0 16 16"} width="24" height="24" aria-hidden="true" focusable="false">
  {naam === "menu" && <g stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"><path d="M3 6h18M3 12h18M3 18h18" /></g>}
  {
    naam === "vinkje" && (
      <>
        <circle cx="12" cy="12" r="10" fill="currentColor" />
        <path d="M8 12.5l2.8 2.8L16.5 9.5" fill="none" stroke="var(--vinkje, #000)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
      </>
    )
  }
  {naam === "mail" && <g fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3.5 6.5l8.5 6.5 8.5-6.5" /></g>}
  {naam === "linkedin" && <path fill="currentColor" d="M12.225 12.225h-1.778V9.44c0-.664-.012-1.519-.925-1.519-.926 0-1.068.724-1.068 1.47v2.834H6.676V6.498h1.707v.783h.024c.348-.594.996-.95 1.684-.925 1.802 0 2.135 1.185 2.135 2.728l-.001 3.14zM4.67 5.715a1.037 1.037 0 01-1.032-1.031c0-.566.466-1.032 1.032-1.032.566 0 1.031.466 1.032 1.032 0 .566-.466 1.032-1.032 1.032zm.889 6.51h-1.78V6.498h1.78v5.727zM13.11 2H2.885A.88.88 0 002 2.866v10.268a.88.88 0 00.885.866h10.226a.882.882 0 00.889-.866V2.865a.88.88 0 00-.889-.864z" />}
  {naam === "youtube" && <path fill="currentColor" d="M15.8,4.8c-0.2-1.3-0.8-2.2-2.2-2.4C11.4,2,8,2,8,2S4.6,2,2.4,2.4C1,2.6,0.3,3.5,0.2,4.8C0,6.1,0,8,0,8s0,1.9,0.2,3.2c0.2,1.3,0.8,2.2,2.2,2.4C4.6,14,8,14,8,14s3.4,0,5.6-0.4c1.4-0.3,2-1.1,2.2-2.4C16,9.9,16,8,16,8S16,6.1,15.8,4.8z M6,11V5l5,3L6,11z" />}
  {naam === "facebook" && <path fill="currentColor" d="M16,8.048a8,8,0,1,0-9.25,7.9V10.36H4.719V8.048H6.75V6.285A2.822,2.822,0,0,1,9.771,3.173a12.2,12.2,0,0,1,1.791.156V5.3H10.554a1.155,1.155,0,0,0-1.3,1.25v1.5h2.219l-.355,2.312H9.25v5.591A8,8,0,0,0,16,8.048Z" />}
  {naam === "instagram" && <path fill="currentColor" d="M8 1.44c2.14 0 2.39 0 3.23.05 2.17.1 3.18 1.13 3.28 3.28.04.84.05 1.1.05 3.23s0 2.39-.05 3.23c-.1 2.15-1.11 3.18-3.28 3.28-.84.04-1.1.05-3.23.05s-2.39 0-3.23-.05c-2.18-.1-3.18-1.14-3.28-3.28C1.45 10.39 1.44 10.14 1.44 8s0-2.39.05-3.23c.1-2.15 1.11-3.18 3.28-3.28.84-.04 1.09-.05 3.23-.05zM8 3.9a4.1 4.1 0 100 8.2 4.1 4.1 0 000-8.2zm0 6.77a2.67 2.67 0 110-5.34 2.67 2.67 0 010 5.34zm4.27-7.9a.96.96 0 100 1.92.96.96 0 000-1.92z" />}
</svg>

<style>
  .icon {
    width: 1.25em;
    height: 1.25em;
    flex: none;
  }
</style>
