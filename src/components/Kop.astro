---
import { menu } from "../lib/content";
import site from "../data/site.json";
import Icon from "./Icon.astro";

const items = await menu();
const huidig = Astro.url.pathname.replace(/\.html$/, "");
---

<header class="kop">
  <div class="container kop__rij">
    <a class="kop__logo" href="/" aria-label={`${site.titel}, naar de homepage`}>{site.titel}</a>
    <a class="knop kop__actie" href="/#contact"><span class="kop__actie-lang">Proefles plannen</span><span class="kop__actie-kort">Proefles</span></a>
    <button class="kop__menuknop" type="button" aria-expanded="false" aria-controls="hoofdmenu">
      <Icon naam="menu" />
      <span class="sr-only">Menu</span>
    </button>
    <nav id="hoofdmenu" class="kop__nav" aria-label="Hoofdmenu">
      <ul>
        {
          items.map((i) => (
            <li>
              <a href={i.url} aria-current={huidig === i.url ? "page" : undefined}>
                {i.titel}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .kop {
    position: sticky;
    top: 0;
    z-index: 50;
    /* Licht doorschijnend met vervaging; zonder ondersteuning gewoon wit */
    background: var(--kop-bg);
    @supports (backdrop-filter: blur(1px)) {
      background: color-mix(in oklab, var(--kop-bg) 86%, transparent);
      backdrop-filter: saturate(1.4) blur(14px);
    }
    color: var(--kop-tekst);
    padding-top: env(safe-area-inset-top);
    border-block-end: 1px solid var(--petrol-100);
  }
  .kop__rij {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--r-4);
    min-height: var(--kop-hoogte);
    padding-inline: env(safe-area-inset-left) env(safe-area-inset-right);
  }
  .kop__logo {
    font-family: var(--font-kop);
    font-size: 1.625rem;
    letter-spacing: -0.005em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }
  .kop__actie {
    order: 3;
    min-block-size: 40px;
    padding-inline: var(--r-4);
    font-size: var(--tekst-sm);
  }
  .kop__actie-kort {
    display: none;
  }
  .kop__nav {
    margin-inline-start: auto;
  }
  .kop__nav ul {
    display: flex;
    gap: var(--r-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .kop__nav a {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    font-family: var(--font-kop);
    font-size: 1.1875rem;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
    transition: text-decoration-color 0.2s ease;
  }
  .kop__nav a:hover,
  .kop__nav a[aria-current="page"] {
    text-decoration-color: currentColor;
  }
  .kop__menuknop {
    order: 4;
    display: none;
    width: 44px;
    height: 44px;
    margin-right: calc(-1 * var(--r-2));
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  /* Hele smalle schermen (320 px): alles net iets compacter */
  @media (width < 23rem) {
    .kop__logo {
      font-size: 1.1875rem;
    }
    .kop__actie {
      padding-inline: var(--r-3);
    }
  }

  /* Telefoon: menuknop, het menu klapt onder de kop open */
  @media (max-width: 40rem) {
    .kop__rij {
      gap: var(--r-2);
    }
    :global(.js) .kop__rij {
      flex-wrap: nowrap;
    }
    .kop__logo {
      font-size: 1.375rem;
    }
    .kop__actie {
      margin-inline-start: auto;
    }
    .kop__actie-lang {
      display: none;
    }
    .kop__actie-kort {
      display: inline;
    }
    :global(.js) .kop__menuknop {
      display: inline-grid;
      place-items: center;
    }
    :global(.js) .kop__nav {
      display: none;
      position: absolute;
      inset: 100% 0 auto;
      background: var(--kop-bg);
      box-shadow: 0 12px 24px hsl(186 100% 5% / 0.18);
      padding: var(--r-2) var(--r-6) var(--r-4);
    }
    :global(.js) .kop__nav.is-open {
      display: block;
    }
    .kop__nav ul {
      flex-direction: column;
      gap: 0;
    }
    /* Zonder JS staat het menu gewoon onder het logo */
    .kop__rij {
      flex-wrap: wrap;
    }
  }
</style>

<script>
  const knop = document.querySelector<HTMLButtonElement>(".kop__menuknop");
  const nav = document.getElementById("hoofdmenu");
  knop?.addEventListener("click", () => {
    const open = knop.getAttribute("aria-expanded") === "true";
    knop.setAttribute("aria-expanded", String(!open));
    nav?.classList.toggle("is-open", !open);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && nav?.classList.contains("is-open")) {
      nav.classList.remove("is-open");
      knop?.setAttribute("aria-expanded", "false");
      knop?.focus();
    }
  });
</script>
